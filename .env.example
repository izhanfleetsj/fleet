# Copy to .env (or set in your hosting dashboard)
PORT=3000
ADMIN_PASSWORD=change-me
# Optional: a second login for management — sees every page and can filter, but cannot edit anything
MANAGEMENT_PASSWORD=
# Long random string — keeps admins logged in across restarts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Where the SQLite database is stored
DATA_DIR=./data
# Optional locally, required on Vercel: store data in Supabase instead of SQLite
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
